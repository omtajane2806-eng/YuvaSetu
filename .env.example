# ==============================================================================
# YuvaSetu — Production Environment Configuration Template
# Motto: "Samajh Se Safalta Tak"
# IMPORTANT: Never commit actual passwords, private keys, or API tokens to source control.
# Copy this file to .env and supply environment-specific credentials during deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT CONFIG (Client-facing, prefixed with VITE_)
# ------------------------------------------------------------------------------
# Frontend origin / base URL (e.g., https://yuvasetu.edu or https://app.yuvasetu.com)
VITE_APP_URL=
# Custom API URL if frontend and backend are hosted on separate domains/origins
# Leave empty if backend is co-hosted with frontend (same-origin /api)
VITE_API_URL=
# Public CDN / Asset domain for static files (optional)
VITE_STORAGE_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 2. SERVER CONFIG & SECRETS (Backend only, never exposed to client)
# ------------------------------------------------------------------------------
# Environment mode: 'development', 'staging', or 'production'
NODE_ENV=development
# Server HTTP listening port (defaults to 3000)
PORT=3000
# AI Studio / Cloud Run deployment application URL
APP_URL=
# Comma-separated list of allowed CORS origins for production (e.g., https://yuvasetu.com,https://app.yuvasetu.com)
ALLOWED_ORIGINS=
# Cryptographic session/cookie secret (64+ character random string in production)
SESSION_SECRET=
# Password hashing pepper/salt override for production
PASSWORD_PEPPER=

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Path to SQLite database file or connection string for production database
DATABASE_PATH=./data/yuvasetu.sqlite
# Set to 'false' in production to disable automatic demo student seeding
ENABLE_DEMO_SEED=false
# Production Database Connection URL (for future PostgreSQL / Managed SQL deployment)
DATABASE_URL=

# ------------------------------------------------------------------------------
# 4. INITIAL ADMINISTRATOR BOOTSTRAP (For first-time deployment setup only)
# ------------------------------------------------------------------------------
# Primary Platform Administrator Email (used ONLY when initial DB has zero admins)
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_NAME=
ADMIN_INITIAL_PASSWORD=

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & FIREBASE CONFIGURATION
# ------------------------------------------------------------------------------
# Firebase Web Client configuration (for Google Sign-In & Firebase Auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase Admin SDK Service Account JSON path (server-side token verification)
FIREBASE_SERVICE_ACCOUNT_PATH=

# ------------------------------------------------------------------------------
# 6. AI SERVICE CONFIGURATION (Server-side Gemini)
# ------------------------------------------------------------------------------
# Google Gemini API key (kept strictly on server, never exposed in client bundle)
GEMINI_API_KEY=
# AI request rate limit per minute per IP
AI_RATE_LIMIT_PER_MINUTE=40
# Model override (defaults to gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash

# ------------------------------------------------------------------------------
# 7. PERSISTENT VIDEO & FILE STORAGE CONFIGURATION (Cloudinary / AWS S3)
# ------------------------------------------------------------------------------
# In production on Render (where local container disks are ephemeral across redeploys),
# configure either Cloudinary (recommended zero-config) or AWS S3 for permanent video persistence:
#
# Option A: Cloudinary (Recommended for Render)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Or individual Cloudinary credentials:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
#
# Option B: Amazon S3 or S3-compatible Object Storage (Cloudflare R2, MinIO, Supabase S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
# Custom S3 Endpoint (optional, e.g. https://<account_id>.r2.cloudflarestorage.com)
AWS_ENDPOINT=
#
# Storage mode fallback (defaults to 'local' if neither Cloudinary nor S3 is set)
STORAGE_PROVIDER=local
MAX_FILE_SIZE_MB=100

# ------------------------------------------------------------------------------
# 8. EXTERNAL SERVICES & PAYMENT GATEWAY (Optional Integrations)
# ------------------------------------------------------------------------------
# Razorpay / Cashfree / Stripe Keys (if active online token top-ups are enabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Email delivery provider for password recovery & announcements (e.g., SendGrid, Postmark, AWS SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@yuvasetu.com
